<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.McsPreOrderSchoolUniformOnlineShopping">

        <!-- Main Activity / Starting Screen -->
        <activity
            android:name=".loginFeatures"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Uniform Category and Size Selection -->
        <activity
            android:name=".UNIFORMCATEGORY_SIZESELECTION"
            android:exported="true" />

        <!-- Customer Order Information -->
        <activity
            android:name=".Customerorderinfo"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Processing Order -->
        <activity
            android:name=".activity_processingorder"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reservation Pick-up Schedule -->
        <activity
            android:name=".ReservationPickUpSchedule"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Preloaded Fonts -->
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

        <activity
            android:name=".UNIFORM_SizeandQuantity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>