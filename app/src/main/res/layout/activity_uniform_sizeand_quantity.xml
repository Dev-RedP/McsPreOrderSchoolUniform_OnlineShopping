
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="MCS UNIFORMS"
            android:textColor="#000000"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp"
            android:text="SELECT YOUR SIZE"
            android:textColor="#000000"
            android:textSize="21sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/sizeXS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="XS - Extra Small"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

            <RadioButton
                android:id="@+id/sizeS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="S - Small"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

            <RadioButton
                android:id="@+id/sizeM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="M - Medium"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

            <RadioButton
                android:id="@+id/sizeL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="L - Large"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

            <RadioButton
                android:id="@+id/sizeXL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="XL - Extra Large"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

            <RadioButton
                android:id="@+id/sizeXXL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="XXL - Double Extra Large"
                android:textColor="#000000"
                android:textSize="18sp"
                android:buttonTint="#000000" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="QUANTITY"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:backgroundTint="#EEEEEE"
                android:text="-"
                android:textColor="#000000"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtQuantity"
                android:layout_width="80dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="60dp"
                android:layout_height="55dp"
                android:backgroundTint="#EEEEEE"
                android:text="+"
                android:textColor="#000000"
                android:textSize="22sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="25dp"
            android:backgroundTint="#000000"
            android:text="DONE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
